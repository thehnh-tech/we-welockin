# Shared store (optional). Without these the app uses an in-memory store that
# does NOT work across serverless instances — fine for local dev, not for prod.
#
# Create a free Redis database at https://upstash.com (or use Vercel KV) and
# copy the REST URL + token here. Vercel KV variable names are also accepted
# (KV_REST_API_URL / KV_REST_API_TOKEN).

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
