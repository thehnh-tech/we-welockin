# Shared rooms store (pick one). Without either, the app uses an in-memory
# store that does NOT work across serverless instances — fine for local dev,
# not for prod. Preference order at startup: Redis > MongoDB > memory.
#
# Option A — Redis: free database at https://upstash.com (or Vercel KV; the
# KV_REST_API_URL / KV_REST_API_TOKEN names are also accepted).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- MongoDB ---
# Option B for the rooms store, and REQUIRED for the public feed features:
# university verification codes, verified emails, institution requests,
# rate limits, and the feed archive. Free tier: https://www.mongodb.com/atlas
MONGODB_URI=
MONGODB_DB=welockin

# --- Resend (emails: verification codes + institution requests) ---
# https://resend.com — without a key, codes are printed to the server console
# (dev only); production requires it.
RESEND_API_KEY=
# Verified sender, e.g. "welock.in <verify@welock.in>". Defaults to Resend's
# sandbox sender onboarding@resend.dev (delivers only to your own account).
RESEND_FROM=
# Where "request an institution" notifications are sent.
INSTITUTION_REQUESTS_TO=

# --- Auth secret ---
# Signs the university-verification cookie (HMAC-SHA256). REQUIRED in
# production. Generate one with: openssl rand -hex 32
AUTH_SECRET=

# --- SEO ---
# Canonical origin used in metadata/sitemap. Defaults to https://welock.in —
# set it on previews/staging so canonical URLs stay honest.
NEXT_PUBLIC_SITE_URL=

# --- WebRTC (client-side, optional) ---
# TURN server: required for users behind symmetric NAT / strict firewalls
# (corporate Wi-Fi, some cellular). STUN-only works for most home networks.
# Get free credentials at https://www.metered.ca/tools/openrelay/ .
# NEXT_PUBLIC_TURN_URL accepts a single url or a comma-separated list.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Self-hosted peerjs-server (optional). Without these, the PeerJS public cloud
# broker is used for signaling.
NEXT_PUBLIC_PEER_HOST=
NEXT_PUBLIC_PEER_PORT=
NEXT_PUBLIC_PEER_PATH=
NEXT_PUBLIC_PEER_SECURE=
